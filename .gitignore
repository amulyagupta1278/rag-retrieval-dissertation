__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
node_modules
tmp/
.env
.venv/
venv/
*.pkl
!indexes/bm25/bm25_index.pkl
!indexes/baselines/**/*.pkl
!releases/**/*.pkl
indexes/faiss/*.index
indexes/faiss/*.jsonl
indexes/graphrag/*.gpickle
**/__pycache__/
**/*.pyc
# LibreOffice / Excel session lock files
.~lock.*#
**/.~lock.*#

# Backup files created during editing
*.bak

# Session-local Claude outputs and config
outputs/
.claude/

# indexes/baselines/ and releases/ are frozen, hash-manifested deliverable
# bundles and are intentionally tracked (see releases/*/manifests/SHA256SUMS).
# Do not blanket-ignore them here; use the request_payloads/raw/validated
# rules below to exclude scratch artifacts within them instead.

# stray zip temp artifacts (sandbox cannot unlink)
runs/v2/**/zi[0-9A-Za-z]*

**/.DS_Store
.DS_Store

# Provider request/response bodies stay local. Commit only manifests,
# summaries, ledgers, schemas, and aggregate analysis artifacts.
**/request_payloads.jsonl
**/raw/
**/validated/
